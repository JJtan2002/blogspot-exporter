# Optional Configuration Example for Blogspot Ingestion Pipeline
# No API keys or secrets are required for local XML ingestion.

# Default path to Blogger/Blogspot XML export archive
BLOGSPOT_EXPORT_PATH=sample_export.xml

# Default output directory for generated Markdown posts
BLOGSPOT_OUTPUT_DIR=output/posts

# Default document classification for YAML frontmatter
DEFAULT_CLASSIFICATION=personal_analysis
